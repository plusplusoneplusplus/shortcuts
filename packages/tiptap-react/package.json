{
  "name": "@plusplusoneplusplus/tiptap-react",
  "version": "0.1.0",
  "description": "React editor shell and formatting toolbar for Tiptap, built on @plusplusoneplusplus/tiptap-kit",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plusplusoneplusplus/shortcuts.git",
    "directory": "packages/tiptap-react"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid/index.d.ts",
      "import": "./dist/mermaid/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@plusplusoneplusplus/tiptap-kit": "^0.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "katex": "^0.16.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plusplusoneplusplus/tiptap-kit": "^0.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^27.0.1",
    "katex": "^0.16.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
