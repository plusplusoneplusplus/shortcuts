{
  "name": "@plusplusoneplusplus/coc-native",
  "version": "0.1.0",
  "description": "Rust/N-API indexes for CoC quick-open file search and bounded Notes content search",
  "napi": {
    "name": "coc-native"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": [
    "dist",
    "prebuilt",
    "*.node"
  ],
  "scripts": {
    "build": "tsc",
    "build:native": "node scripts/build-native.mjs",
    "bench:git": "node scripts/bench-git.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
