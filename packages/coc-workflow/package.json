{
  "name": "@plusplusoneplusplus/coc-workflow",
  "version": "0.1.0",
  "description": "Pure DAG workflow compiler and executor for CoC YAML workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "workflow": [
        "dist/workflow/index.d.ts"
      ],
      "ralph": [
        "dist/ralph/index.d.ts"
      ],
      "logger": [
        "dist/logger.d.ts"
      ],
      "errors": [
        "dist/errors/index.d.ts"
      ],
      "errors/error-codes": [
        "dist/errors/error-codes.d.ts"
      ],
      "errors/pipeline-core-error": [
        "dist/errors/pipeline-core-error.d.ts"
      ],
      "runtime/cancellation": [
        "dist/runtime/cancellation.d.ts"
      ],
      "runtime/concurrency-limiter": [
        "dist/runtime/concurrency-limiter.d.ts"
      ],
      "config/defaults": [
        "dist/config/defaults.d.ts"
      ],
      "utils/prompt-resolver": [
        "dist/utils/prompt-resolver.d.ts"
      ],
      "utils/csv-reader": [
        "dist/utils/csv-reader.d.ts"
      ],
      "utils/template-engine": [
        "dist/utils/template-engine.d.ts"
      ],
      "skills/skill-resolver": [
        "dist/skills/skill-resolver.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./workflow": "./dist/workflow/index.js",
    "./ralph": "./dist/ralph/index.js",
    "./logger": "./dist/logger.js",
    "./errors": "./dist/errors/index.js",
    "./errors/error-codes": "./dist/errors/error-codes.js",
    "./errors/pipeline-core-error": "./dist/errors/pipeline-core-error.js",
    "./runtime/cancellation": "./dist/runtime/cancellation.js",
    "./runtime/concurrency-limiter": "./dist/runtime/concurrency-limiter.js",
    "./config/defaults": "./dist/config/defaults.js",
    "./utils/prompt-resolver": "./dist/utils/prompt-resolver.js",
    "./utils/csv-reader": "./dist/utils/csv-reader.js",
    "./utils/template-engine": "./dist/utils/template-engine.js",
    "./skills/skill-resolver": "./dist/skills/skill-resolver.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:diff": "bash ../../scripts/coverage-diff.sh",
    "lint": "eslint src"
  },
  "dependencies": {
    "@plusplusoneplusplus/coc-agent-sdk": "*",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
