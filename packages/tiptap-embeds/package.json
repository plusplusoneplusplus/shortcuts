{
  "name": "@plusplusoneplusplus/tiptap-embeds",
  "version": "0.1.0",
  "description": "Media embed extensions for Tiptap (YouTube, maps, PDF, papers), built on @plusplusoneplusplus/tiptap-kit",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plusplusoneplusplus/shortcuts.git",
    "directory": "packages/tiptap-embeds"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@plusplusoneplusplus/tiptap-kit": "^0.1.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
